APP_NAME=GolpoBari
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://golpobari.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=golpobari
DB_USERNAME=golpobari
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@golpobari.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- GolpoBari ---
# Admin panel URL prefix. Change it to something less guessable if you like.
ADMIN_PATH=admin
# Set only if the site sits behind Cloudflare or another proxy (comma-separated IPs or CIDRs).
TRUSTED_PROXIES=
# Idle minutes before an admin is logged out automatically.
ADMIN_IDLE_TIMEOUT=120

# Used ONLY by `php artisan golpobari:create-admin --from-env` (then remove them).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
